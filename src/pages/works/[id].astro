---
import Base from '../../layouts/Base.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import { getWorks } from '../../lib/works.js';
import { href } from '../../lib/url.js';

// 各作品ページを静的生成。前後の作品も props で渡してツアー回遊を可能にする。
export function getStaticPaths() {
  const works = getWorks();
  return works.map((work, i) => ({
    params: { id: work.id },
    props: {
      work,
      prev: works[i - 1] ?? null,
      next: works[i + 1] ?? null,
    },
  }));
}

const { work, prev, next } = Astro.props;
// 音声は複数可（共作で話者が複数のとき）。話者ラベル付き。
const audios = (work.audios || []).map((a) => ({ src: href(a.src), label: a.label }));
const thumbSrc = work.thumbnail ? href(work.thumbnail) : '';
const ogImage = thumbSrc || undefined;
// 作家表記：西田 香代子（刺繍作家）
const artistLine = work.role ? `${work.artist}（${work.role}）` : work.artist;
// 紹介ムービーが無い作品は、作品写真をヒーローとして大きく表示する
const showPhoto = !work.youtube_id && thumbSrc;
---

<Base title={work.title} description={`${artistLine}｜${work.title}`} image={ogImage}>
  <div class="work-head">
    <span class="work-num">No.{work.id}</span>
    <h1 class="work-title">{work.title}</h1>
    {work.title_en && <p class="work-title-en">{work.title_en}</p>}
    <p class="work-artist">
      {artistLine}
      {work.artist_en && <span class="work-artist-en">{work.artist_en}</span>}
    </p>
    {work.location && <p class="work-location">📍 {work.location}</p>}
  </div>

  {/* 作品写真（紹介ムービーが無い作品のヒーロー） */}
  {
    showPhoto && (
      <img
        class="work-photo"
        src={thumbSrc}
        alt={`${work.title}（${work.artist}）`}
        loading="eager"
      />
    )
  }

  {/* 音声ガイド（主動線。回線が弱くても軽く再生できる） */}
  <p class="section-label">音声ガイド</p>
  {
    audios.length > 0 ? (
      <div class="audio-block">
        {audios.map((a, i) => (
          <div class={i > 0 ? 'audio-item audio-item--sep' : 'audio-item'}>
            {a.label && <p class="audio-label">{a.label}</p>}
            <div class="player" data-work-id={work.id} data-audio-label={a.label}>
              <audio class="player-audio" preload="metadata" src={a.src}></audio>
              <div class="player-row">
                <button type="button" class="player-play" aria-label="再生">
                  <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                  <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
                  <span class="player-playlabel">再生</span>
                </button>
                <button type="button" class="player-stop" aria-label="停止">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2" /></svg>
                  <span>停止</span>
                </button>
              </div>
              <input class="player-seek" type="range" min="0" max="100" value="0" step="0.1" aria-label="再生位置" />
              <div class="player-time"><span class="player-cur">0:00</span> / <span class="player-dur">0:00</span></div>
            </div>
          </div>
        ))}
        <p class="audio-note">🎧 イヤホン・ヘッドホンでの再生がおすすめです。</p>
      </div>
    ) : (
      <p class="audio-pending">
        🎧 この作品の音声ガイドは準備中です。近日公開予定ですので、今しばらくお待ちください。
      </p>
    )
  }

  {/* 紹介ムービー（YouTube 限定公開。ある作品のみ） */}
  {
    work.youtube_id && (
      <>
        <p class="section-label">紹介ムービー</p>
        <YouTubeEmbed id={work.youtube_id} title={work.title} />
      </>
    )
  }

  {/* 解説テキスト（日本語の下に少し間を空けて英語を併記） */}
  {
    work.description && (
      <>
        <p class="section-label">解説</p>
        <p class="work-desc">{work.description}</p>
        {
          work.description_en && (
            <>
              <p class="work-desc work-desc-en">{work.description_en}</p>
              <p class="work-desc-note">
                English translation is AI-generated for reference and is not an official
                translation by the artist.<br />
                英訳はAIによる参考翻訳です（誤りを含む場合があります）。アーティスト公式の翻訳ではありません。
              </p>
            </>
          )
        }
      </>
    )
  }

  {/* 前後の作品へ（ツアー的な回遊） */}
  <nav class="pager" aria-label="作品の移動">
    {
      prev ? (
        <a class="prev" href={href(`works/${prev.id}/`)}>
          ← No.{prev.id} {prev.title}
        </a>
      ) : (
        <span class="prev disabled">← 最初の作品です</span>
      )
    }
    {
      next ? (
        <a class="next" href={href(`works/${next.id}/`)}>
          No.{next.id} {next.title} →
        </a>
      ) : (
        <span class="next disabled">最後の作品です →</span>
      )
    }
  </nav>

  <a class="back-home" href={href('')}>← 作品一覧へ戻る</a>
</Base>

<script>
  // カスタム音声プレーヤー：大きな「再生/一時停止」と「停止」ボタン・シーク・時間表示
  const fmt = (s: number) => {
    if (!isFinite(s) || s < 0) return '0:00';
    const t = Math.floor(s);
    return `${Math.floor(t / 60)}:${String(t % 60).padStart(2, '0')}`;
  };
  document.querySelectorAll<HTMLElement>('.player').forEach((player) => {
    const audio = player.querySelector('audio') as HTMLAudioElement | null;
    const playBtn = player.querySelector('.player-play') as HTMLButtonElement | null;
    const stopBtn = player.querySelector('.player-stop') as HTMLButtonElement | null;
    const seek = player.querySelector('.player-seek') as HTMLInputElement | null;
    const cur = player.querySelector('.player-cur');
    const dur = player.querySelector('.player-dur');
    const label = player.querySelector('.player-playlabel');
    if (!audio || !playBtn || !stopBtn || !seek) return;

    const setDur = () => { if (dur) dur.textContent = fmt(audio.duration); };
    if (audio.readyState >= 1) setDur();
    audio.addEventListener('loadedmetadata', setDur);

    playBtn.addEventListener('click', () => {
      if (audio.paused) audio.play(); else audio.pause();
    });
    stopBtn.addEventListener('click', () => {
      audio.pause();
      audio.currentTime = 0;
    });

    let played = false;
    audio.addEventListener('play', () => {
      // 同じページの他の音声は止める
      document.querySelectorAll('audio').forEach((a) => { if (a !== audio) a.pause(); });
      playBtn.classList.add('is-playing');
      playBtn.setAttribute('aria-label', '一時停止');
      if (label) label.textContent = '一時停止';
      // 計測：作品ごとの音声再生（GA4のカスタムイベント audio_play）
      if (!played) {
        played = true;
        const w = window as any;
        const params = {
          work_id: player.dataset.workId || '',
          audio_label: player.dataset.audioLabel || '',
        };
        if (typeof w.gtag === 'function') {
          w.gtag('event', 'audio_play', params);
        } else {
          w.dataLayer = w.dataLayer || [];
          w.dataLayer.push({ event: 'audio_play', ...params });
        }
      }
    });
    const toPaused = () => {
      playBtn.classList.remove('is-playing');
      playBtn.setAttribute('aria-label', '再生');
      if (label) label.textContent = '再生';
    };
    audio.addEventListener('pause', toPaused);
    audio.addEventListener('ended', () => {
      toPaused();
      if (cur) cur.textContent = '0:00';
      seek.value = '0';
    });
    audio.addEventListener('timeupdate', () => {
      if (cur) cur.textContent = fmt(audio.currentTime);
      if (audio.duration) seek.value = String((audio.currentTime / audio.duration) * 100);
    });
    seek.addEventListener('input', () => {
      if (audio.duration) audio.currentTime = (Number(seek.value) / 100) * audio.duration;
    });
  });
</script>
