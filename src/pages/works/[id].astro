---
import Base from '../../layouts/Base.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import { getWorks } from '../../lib/works.js';
import { href } from '../../lib/url.js';

// 各作品ページを静的生成。前後の作品も props で渡してツアー回遊を可能にする。
export function getStaticPaths() {
  const works = getWorks();
  return works.map((work, i) => ({
    params: { id: work.id },
    props: {
      work,
      prev: works[i - 1] ?? null,
      next: works[i + 1] ?? null,
    },
  }));
}

const { work, prev, next } = Astro.props;
// 音声は複数可（共作で話者が複数のとき）。話者ラベル付き。
const audios = (work.audios || []).map((a) => ({ src: href(a.src), label: a.label }));
const thumbSrc = work.thumbnail ? href(work.thumbnail) : '';
const ogImage = thumbSrc || undefined;
// 作家表記：西田 香代子（刺繍作家）
const artistLine = work.role ? `${work.artist}（${work.role}）` : work.artist;
// 紹介ムービーが無い作品は、作品写真をヒーローとして大きく表示する
const showPhoto = !work.youtube_id && thumbSrc;
---

<Base title={work.title} description={`${artistLine}｜${work.title}`} image={ogImage}>
  <div class="work-head">
    <span class="work-num">No.{work.id}</span>
    <h1 class="work-title">{work.title}</h1>
    {work.title_en && <p class="work-title-en">{work.title_en}</p>}
    <p class="work-artist">
      {artistLine}
      {work.artist_en && <span class="work-artist-en">{work.artist_en}</span>}
    </p>
    {work.location && <p class="work-location">📍 {work.location}</p>}
  </div>

  {/* 作品写真（紹介ムービーが無い作品のヒーロー） */}
  {
    showPhoto && (
      <img
        class="work-photo"
        src={thumbSrc}
        alt={`${work.title}（${work.artist}）`}
        loading="eager"
      />
    )
  }

  {/* 音声ガイド（主動線。回線が弱くても軽く再生できる） */}
  <p class="section-label">音声ガイド</p>
  {
    audios.length > 0 ? (
      <div class="audio-block">
        {audios.map((a, i) => (
          <div class={i > 0 ? 'audio-item audio-item--sep' : 'audio-item'}>
            {a.label && <p class="audio-label">{a.label}</p>}
            <audio controls preload="none" src={a.src}>
              お使いのブラウザは音声再生に対応していません。
            </audio>
          </div>
        ))}
        <p class="audio-note">🎧 イヤホン・ヘッドホンでの再生がおすすめです。</p>
      </div>
    ) : (
      <p class="audio-pending">
        🎧 この作品の音声ガイドは準備中です。近日公開予定ですので、今しばらくお待ちください。
      </p>
    )
  }

  {/* 紹介ムービー（YouTube 限定公開。ある作品のみ） */}
  {
    work.youtube_id && (
      <>
        <p class="section-label">紹介ムービー</p>
        <YouTubeEmbed id={work.youtube_id} title={work.title} />
      </>
    )
  }

  {/* 解説テキスト（日本語の下に少し間を空けて英語を併記） */}
  {
    work.description && (
      <>
        <p class="section-label">解説</p>
        <p class="work-desc">{work.description}</p>
        {work.description_en && <p class="work-desc work-desc-en">{work.description_en}</p>}
      </>
    )
  }

  {/* 前後の作品へ（ツアー的な回遊） */}
  <nav class="pager" aria-label="作品の移動">
    {
      prev ? (
        <a class="prev" href={href(`works/${prev.id}/`)}>
          ← No.{prev.id} {prev.title}
        </a>
      ) : (
        <span class="prev disabled">← 最初の作品です</span>
      )
    }
    {
      next ? (
        <a class="next" href={href(`works/${next.id}/`)}>
          No.{next.id} {next.title} →
        </a>
      ) : (
        <span class="next disabled">最後の作品です →</span>
      )
    }
  </nav>

  <a class="back-home" href={href('')}>← 作品一覧へ戻る</a>
</Base>
